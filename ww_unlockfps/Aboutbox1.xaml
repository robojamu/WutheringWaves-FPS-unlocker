<Window x:Class="ww_unlockfps.Aboutbox1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ww_unlockfps"
        mc:Ignorable="d"
        Title="关于" Height="250" Width="450" ResizeMode="NoResize">

    <DockPanel Background="{DynamicResource GradientBackground}">

        <StackPanel Orientation="Vertical" VerticalAlignment="Center" >

            <Label Content="鸣潮 FPS 解锁工具" VerticalAlignment="Center" FontFamily="Meiryo" FontSize="15" HorizontalAlignment="Center"/>
            <Label Content="v1.6.6 _beta date:20260621" FontFamily="Meiryo" FontSize="13" HorizontalContentAlignment="Stretch" HorizontalAlignment="Center" Foreground="DarkBlue" Margin="5"/>
            <Label Content="请让程序保持在后台运行，否则" FontFamily="Meiryo" FontSize="13" Foreground="#FFD51515" HorizontalAlignment="Center" FontWeight="Bold" Margin="5"/>
            <Label Content="解锁的帧率将不会生效！" HorizontalAlignment="Center" FontFamily="Meiryo" FontSize="13" Foreground="#FFE72A2A" FontWeight="Bold"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,35,0,0">
                <TextBlock Text="作者：30launcher  " FontSize="16" FontFamily="Meiryo" Foreground="DarkOrange"/>
                <TextBlock TextWrapping="Wrap" FontSize="16" FontFamily="Meiryo"><Hyperlink NavigateUri="https://space.bilibili.com/456492426" RequestNavigate="Hyperlink_RequestNavigate">Bilibili</Hyperlink>
                </TextBlock>
                <TextBlock TextWrapping="Wrap" FontSize="16" FontFamily="Meiryo" Margin="10,0,0,0"><Hyperlink NavigateUri="https://github.com/30launchers/WutheringWaves-FPS-unlocker" RequestNavigate="Hyperlink_RequestNavigate">GitHub</Hyperlink>
                </TextBlock>
            </StackPanel>

        </StackPanel>

    </DockPanel>
    <Window.Resources>
        <LinearGradientBrush x:Key="GradientBackground" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFD2E3FE" Offset="1" />
            <GradientStop Color="White" Offset="0" />
        </LinearGradientBrush>
    </Window.Resources>

</Window>
