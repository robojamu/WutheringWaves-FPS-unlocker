<Window x:Class="ww_unlockfps.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ww_unlockfps"
        mc:Ignorable="d"
        xmlns:xctk="clr-namespace:Xceed.Wpf.Toolkit;assembly=Xceed.Wpf.Toolkit"
        Title="鸣潮 FPS 解锁工具" Height="365" Width="350" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">

    <DockPanel Background="{DynamicResource GradientBackground}">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="选项(_O)" Height="23">
                <MenuItem Header="设置(_S)" Click="Setup_Click" ToolTip="设置游戏 EXE 路径"/>
                <MenuItem Header="手动模式(_M)" Click="Advance_Launch"/>
                <MenuItem x:Name="check_auto_start" Header="自动启动(_A)" IsCheckable="True" Checked="AutoStart_Checked" Unchecked="AutoStart_Unchecked" ToolTip="快速启动，跳过界面"/>
                <MenuItem x:Name="check_auto_close" Header="自动关闭(_C)" IsCheckable="True" ToolTip="游戏退出时自动关闭本程序"/>
                <MenuItem x:Name="check_power_saving" Header="省电模式(_P)" IsCheckable="True" ToolTip="游戏失去焦点时自动将 FPS 设为 15 并降低进程优先级" Checked="Power_Saving_Checked" Unchecked="Power_Saving_Unchecked"/>
                <MenuItem x:Name="check_clearcache" Header="清除缓存(_C)" Click="ClearCache_Click" ToolTip="重置高级功能缓存"/>
                <MenuItem x:Name="check_game_process_priority" Header="游戏进程优先级(_G)">
                    <MenuItem x:Name="ck_realtime" Header="实时(_R)" IsCheckable="True" Click="Priority_Click"/>
                    <MenuItem x:Name="ck_high" Header="高(_H)" IsCheckable="True" Click="Priority_Click"/>
                    <MenuItem x:Name="ck_above_normal" Header="高于正常(_A)" IsCheckable="True" Click="Priority_Click"/>
                    <MenuItem x:Name="ck_normal" Header="正常(_N)" IsCheckable="True" Click="Priority_Click"/>
                    <MenuItem x:Name="ck_below_normal" Header="低于正常(_B)" IsCheckable="True" Click="Priority_Click"/>
                    <MenuItem x:Name="ck_low" Header="低(_L)" IsCheckable="True" Click="Priority_Click"/>
                    <MenuItem x:Name="ck_default" Header="默认(_D)" IsCheckable="True" Click="Priority_Click"/>
                </MenuItem>
                <MenuItem Header="关于(_A)" Click="About_Click"/>
                <Separator />
                <MenuItem Header="退出(_E)" Click="Exit_Main"/>
            </MenuItem>
        </Menu>


        <!-- 1. 将 Orientation 改为 Vertical (垂直排列) -->
        <!-- 2. 保持 HorizontalAlignment="Center"，这样内部所有元素都会居中 -->
        <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,0">

            <!-- 第一行：FPS文字和输入框 -->
            <!-- 使用嵌套的StackPanel让它们在同一行 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <!-- 底部加点间距 -->
                <TextBlock Text="FPS:" Width="32"
                   VerticalAlignment="Center" 
                   FontSize="14"
                   Margin="0,0,10,0"/>

                <xctk:IntegerUpDown x:Name="Tb_main"
                            Minimum="0" 
                            Maximum="420" 
                            FontSize="13"           
                            PreviewKeyDown="TextBox_PreviewKeyDown"
                            PreviewTextInput="TextBox_PreviewTextInput"   
                            ValueChanged="Tb_main_ValueChanged"
                            Increment="1" 
                            ShowButtonSpinner="True" 
                            FormatString="N0" 
                            Width="260" 
                            Height="28" 
                            TextAlignment="Left"/>
            </StackPanel>

            <!-- 第二行：滑块控件 (自动位于正下方并居中) -->
            <Slider Style="{DynamicResource SliderStyle1}" 
            x:Name="sli_main"
            Width="280" 
            ValueChanged="Slider_ValueChanged_Main"
            Maximum="420" 
            Minimum="0"  
            TickPlacement="None" 
            TickFrequency="1" 
            IsSnapToTickEnabled="True" 
            SelectionEnd="{Binding RelativeSource={RelativeSource Self},Path=Value}" 
            IsSelectionRangeEnabled="True" 
            VerticalAlignment="Center"/>











            <StackPanel Orientation="Horizontal" Margin="0,20,0,15">
                <!-- 底部加点间距 -->
                <TextBlock Text="FOV:" Width="32"
                   VerticalAlignment="Center" 
                   FontSize="14"
                   Margin="0,0,10,0"/>

                <xctk:DoubleUpDown
                            x:Name="Tb_fov"
                            Minimum="15" 
                            Maximum="165" 
                            FontSize="13"           
                            ValueChanged="Tb_fov_ValueChanged"
                            Increment="0.1" 
                            ShowButtonSpinner="True" 
                            FormatString="F1"
                            Width="260" 
                            Height="28" 
                            TextAlignment="Left"/>
            </StackPanel>

            <Slider Style="{DynamicResource SliderStyle1}" 
                x:Name="sli_fov"
                Width="280" 
                Maximum="165" 
                Minimum="15"  
                Value="45"
                ValueChanged="Slider_ValueChanged_fov"
                TickPlacement="None" 
                TickFrequency="0.1" 
                IsSnapToTickEnabled="False" 
                SelectionEnd="{Binding RelativeSource={RelativeSource Self},Path=Value}" 
                IsSelectionRangeEnabled="True" 
                VerticalAlignment="Center"/>






            <!-- 使用 Grid 替代 StackPanel -->
            <Grid Margin="0,15,0,0">

                <!-- 左边的 CheckBox：默认靠左 -->
                <CheckBox 
                  x:Name="cb_advanced"
                  Content="高级功能（测试版）" Foreground="RoyalBlue"
                  VerticalContentAlignment="Center"
                  FontSize="13"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left">

                    <CheckBox.ToolTip>
                        <ToolTip Content="请在启动游戏前开启，否则不生效"/>
                    </CheckBox.ToolTip>
                </CheckBox>
            </Grid>

            <!-- 使用 Grid 替代 StackPanel -->
            <Grid Margin="0,15,0,0">

                <!-- 左边的 CheckBox：默认靠左 -->
                <CheckBox 
                  x:Name="check_fov"
                  IsEnabled="{Binding IsChecked, ElementName=cb_advanced}"
                  Content="启用 FOV 调整"
                  VerticalContentAlignment="Center" Foreground="RoyalBlue"
                  FontSize="13"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left">

                    <CheckBox.ToolTip>
                        <ToolTip Content="暂无"/>
                    </CheckBox.ToolTip>
                </CheckBox>

                <CheckBox          
                  x:Name="check_hideuid"
                  IsEnabled="{Binding IsChecked, ElementName=cb_advanced}"
                  Content="隐藏 UID" Foreground="RoyalBlue"
                  VerticalContentAlignment="Center" Margin="135,0,0,0"
                  FontSize="13"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left">
                    <CheckBox.ToolTip>
                        <ToolTip Content="暂无"/>
                    </CheckBox.ToolTip>
                </CheckBox>

            </Grid>


            <!-- 使用 Grid 替代 StackPanel -->
            <Grid Margin="0,15,0,0">

                <!-- 左边的 CheckBox：默认靠左 -->
                <CheckBox 
                  x:Name="check_removeblur"
                  IsEnabled="{Binding IsChecked, ElementName=cb_advanced}"
                  Content="关闭视角虚化（启动前开启）" Foreground="RoyalBlue"
                  VerticalContentAlignment="Center"
                  FontSize="13"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left">

                    <CheckBox.ToolTip>
                        <ToolTip Content="请在启动游戏前开启，否则不生效"/>
                    </CheckBox.ToolTip>
                </CheckBox>
            </Grid>

            <!-- 使用 Grid 替代 StackPanel -->
            <Grid Margin="0,12,0,0">

                <!-- 左边的 CheckBox：默认靠左 -->
                <CheckBox x:Name="check_dx11"
              Content="使用 DX11 启动游戏"
              VerticalContentAlignment="Center"
              FontSize="13"
              VerticalAlignment="Center"
              HorizontalAlignment="Left">

                    <CheckBox.ToolTip>
                        <ToolTip Content="尝试使用 DirectX 11 启动游戏"/>
                    </CheckBox.ToolTip>
                </CheckBox>

                <!-- 右边的 Button：手动设置为靠右 -->
                <Button x:Name="start_but"
                Content="启动游戏"
                Width="80" 
                Height="25"
                HorizontalAlignment="Right"
                VerticalAlignment="Center" Click="Start_Game"/>

            </Grid>


        </StackPanel>






    </DockPanel>

    <!-- 在资源字典中定义渐变背景 -->
    <Window.Resources>
        <LinearGradientBrush x:Key="GradientBackground" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFD2E3FE" Offset="1" />
            <GradientStop Color="White" Offset="0" />
        </LinearGradientBrush>
    </Window.Resources>
</Window>
    
    
    
    

